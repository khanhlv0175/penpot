# =============================================================================
# Docker Hardened Images (DHI) migration -- Debian 13 (trixie)
# =============================================================================
# dhi.io/node directly, instead of debian-base + a manual Node tarball
# download -- this is a single-purpose Node service, a good fit for DHI's
# dedicated Node image. Real multi-stage: "-dev" (apt+npm+shell, for
# `./setup`) -> true non-dev runtime (no shell, no apt).
#
# Full rationale and troubleshooting history:
# see docs/technical-guide/developer/dhi-migration-notes.md
#
# Requires: docker login dhi.io (free Docker ID -- DHI is free/Apache 2.0
# since Dec 2025, no paid subscription needed; see the migration notes doc
# for details)
# =============================================================================

# -----------------------------------------------------------------------------
# STAGE 1: build -- DHI "dev" Node image (has apt, npm, shell, root)
# -----------------------------------------------------------------------------
FROM dhi.io/node:24.18.0-debian13-dev AS build
LABEL maintainer="Penpot <docker@penpot.app>"

ENV DEBIAN_FRONTEND=noninteractive

ARG BUNDLE_PATH="./bundle-mcp/"
COPY $BUNDLE_PATH /opt/penpot/mcp/

WORKDIR /opt/penpot/mcp

RUN ./setup

# -----------------------------------------------------------------------------
# STAGE 2: runtime -- true DHI minimal Node image (no shell, no apt)
# -----------------------------------------------------------------------------
FROM dhi.io/node:24.18.0-debian13 AS image
LABEL maintainer="Penpot <docker@penpot.app>"

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PENPOT_MCP_SERVER_HOST=0.0.0.0

COPY --from=build --chown=node:node /opt/penpot/mcp /opt/penpot/mcp

WORKDIR /opt/penpot/mcp
USER node

CMD ["node", "index.js", "--multi-user"]
